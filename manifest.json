{
  "manifest_version": 3,
  "name": "Web Timer",
  "version": "1.0.0",
  "description": "設定したWebサイトの利用時間を計測し、15分ごとにお知らせします。",
  "permissions": [
    "storage",
    "scripting"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Web Timer"
  },
  "background": {
    "service_worker": "background.js"
  }
}
